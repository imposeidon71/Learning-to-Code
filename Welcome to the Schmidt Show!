    <!-- Popup Form -->
    <div id="eventPopup" class="event-popup">
        <div class="event-popup-content">
            <span class="close" onclick="closePopup()">&times;</span>
            <h2>Add/Edit Event</h2>
            <form id="eventForm">
                <label for="eventDate">Date:</label>
                <input type="date" id="eventDate" required>
                <label for="eventTitle">Title:</label>
                <input type="text" id="eventTitle" required>
                <label for="eventDetails">Details:</label>
                <textarea id="eventDetails" rows="3"></textarea>
                <label for="recurring">Recurring:</label>
                <select id="recurring">
                    <option value="none">None</option>
                    <option value="daily">Daily</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly">Monthly</option>
                </select>
                <label for="recurrenceStart">Recurrence Start Date:</label>
                <input type="date" id="recurrenceStart">
                <label for="recurrenceEnd">Recurrence End Date:</label>
                <input type="date" id="recurrenceEnd">
                <button type="submit">Add Event</button>
            </form>
        </div>
    </div>

